  shell('<div class="card"><h3>Perfil da loja</h3><label>Nome</label><input id="a" value="'+esc(m.name)+'"><div class="g2"><div><label>Telefone / WhatsApp</label><input id="b" value="'+esc(m.phone)+'" placeholder="(19) 99999-9999"></div><div><label>Horário</label><input id="c" value="'+esc(m.hours)+'" placeholder="Seg a Dom, 11h às 23h"></div></div><div class="g2"><div><label>Instagram</label><input id="i1" value="'+esc(m.insta||'')+'" placeholder="@sualoja"></div><div><label>Facebook</label><input id="i2" value="'+esc(m.face||'')+'" placeholder="suapagina"></div></div><label>Descrição da loja</label><input id="ab" maxlength="200" value="'+esc(m.about||'')+'" placeholder="Ex: Hambúrgueres artesanais desde 2015"><label>Endereço</label><input id="ar" maxlength="120" value="'+esc(m.address||'')+'" placeholder="Rua, número, bairro, cidade"><label>Cor da marca</label><input id="d" type="color" value="'+m.color+'" style="height:44px;padding:4px"><label>Logo</label><input id="f" type="file" accept="image/*"><button id="sp">Salvar perfil</button></div>');
  $('f').onchange=function(e){if(e.target.files[0])img(e.target.files[0],160,function(d){lg=d})};
  $('sp').onclick=function(){m.name=$('a').value.trim()||m.name;m.phone=$('b').value;m.hours=$('c').value;m.color=$('d').value;m.insta=$('i1').value.trim();m.face=$('i2').value.trim();m.about=$('ab').value.trim();m.address=$('ar').value.trim();m.logo=lg;save();toast('Perfil salvo!');viewPanel('profile')}}
 else if(tab==='plan'){var nu=m.tables.length;
  shell('<div class="card"><h3>Plano Básico</h3><p>Implantação inicial: <b>R$ 200,00</b> (primeiro pagamento). Mensalidade a partir do mês seguinte: <b>R$ 100,00</b>.</p><ul class="ck"><li>Até '+LIMIT+' unidades de suportes para QR code incluídas</li><li>QR codes para as unidades configuradas</li></ul><p>Unidades em uso: <b>'+nu+' de '+LIMIT+'</b></p><p>Status do pagamento: <b>aguardando confirmação</b>. A cobrança online ainda não está integrada, então nenhum pagamento é registrado automaticamente.</p></div><div class="card"><h3>Precisa de mais de 10 unidades?</h3><p>Solicite um orçamento personalizado para o seu estabelecimento.</p><button id="orc2">Solicitar orçamento</button></div>');
  $('orc2').onclick=orcamento}}

function viewMenu(id,tok){document.body.classList.add('fire');if(me&&S.users[me]&&S.users[me].id===id){var bk=document.createElement('button');bk.id='bk';bk.className='s sm';bk.textContent='Voltar ao painel';bk.style.cssText='position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);left:12px;z-index:60;background:#000!important';bk.onclick=function(){go('loja')};document.body.appendChild(bk)}var R=resolve(id,tok),m=R.m,mesa=R.t?('0'+R.t.n).slice(-2):'';if(R.err){app.innerHTML='<div class="n"><h2>QR code inválido</h2><p>'+R.err+'</p></div>';return}
 if(!m||!m.active){app.innerHTML='<div class="n"><h2>Cardápio indisponível</h2><p>'+(m?'Este estabelecimento está temporariamente indisponível.':'Cardápio não encontrado neste aparelho.')+' Chame o atendente.</p></div>';return}
 document.documentElement.style.setProperty('--ac',m.color);var cats=[],act='',q='',cover=true,items=m.items;items.forEach(function(i){if(cats.indexOf(i.cat)<0)cats.push(i.cat)});
 function draw(){var list=items.filter(function(i){return(!act||i.cat===act)&&(!q||(i.name+i.desc).toLowerCase().indexOf(q)>=0)});
  if(cover){var ig=m.insta?'<a href="https://instagram.com/'+esc(m.insta.replace(/^@/,''))+'" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>':'',fb=m.face?'<a href="https://facebook.com/'+esc(m.face.replace(/^@/,''))+'" target="_blank" rel="noopener" aria-label="Facebook">f</a>':'';
   app.innerHTML='<div class="cv"><div>'+(m.logo?'<img class="cv-logo" src="'+m.logo+'" alt="">':'<div class="cv-emoji">'+svgBurger()+'</div>')+'<h1 class="cv-t">'+esc(m.name)+'</h1><div class="cv-s">Cardápio digital'+(mesa?' · Mesa '+esc(mesa):'')+'</div><button class="fire-btn" id="go">Ver cardápio</button>'+((ig||fb)?'<div class="soc">'+ig+fb+'</div><div class="cv-sc">Clique nos ícones para seguir nossas redes sociais</div>':'')+(m.hours?'<div class="cv-h">'+esc(m.hours)+'</div>':'')+'</div></div>';
   $('go').onclick=function(){cover=false;draw();window.scrollTo(0,0)};return}
  app.innerHTML='<div class="hd">'+(m.logo?'<img src="'+m.logo+'" alt="">':'')+'<h1>'+esc(m.name)+'</h1>'+(mesa?'<p>Mesa '+esc(mesa)+'</p>':'')+(m.hours?'<p>'+esc(m.hours)+'</p>':'')+'</div><div class="n">'+
  '<input id="sq" placeholder="Buscar no cardápio" value="'+esc(q)+'"><div class="tabs"><button class="sm '+(act?'s':'')+'" data-c="">Todos</button>'+cats.map(function(c){return'<button class="sm '+(act===c?'':'s')+'" data-c="'+esc(c)+'">'+esc(c)+'</button>'}).join('')+'</div>'+
  list.map(function(i){return'<div class="card it mi'+(i.off?' off':'')+'">'+(i.img?'<img src="'+i.img+'" alt="">':'<div class="ph">'+artFor(i)+'</div>')+'<div style="flex:1"><b>'+esc(i.name)+'</b><div class="ds">'+esc(i.desc)+'</div><div class="row sb" style="margin-top:6px"><span class="pr">'+brl(i.price)+'</span>'+(i.off?'<span class="badge">Indisponível</span>':'')+'</div></div></div>'}).join('')+(list.length?'':'<p>'+(items.length?'Nada encontrado.':'Este cardápio ainda não tem produtos publicados. Volte em instantes.')+'</p>')+
  '</div>';
  $('sq').oninput=function(e){q=e.target.value.toLowerCase();var p=e.target.selectionStart;draw();$('sq').focus();$('sq').setSelectionRange(p,p)};
  app.querySelectorAll('[data-c]').forEach(function(b){b.onclick=function(){act=b.dataset.c;draw()}});}
 draw()}
boot();
