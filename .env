# Copie para .env.local APENAS para testar no seu computador. NUNCA envie o .env real ao GitHub.
# Na Vercel, cadastre estas variáveis em: Project > Settings > Environment Variables.

# Texto aleatório com 32+ caracteres. Gere com:  openssl rand -hex 32
AUTH_SECRET=troque-por-um-texto-aleatorio-longo

# Banco de dados (Upstash Redis). Ao conectar o banco ao projeto na Vercel, estas duas são criadas sozinhas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
